#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        Left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <16 17>;
        };

        Right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <18 19>;
        };

        Left_parent {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <28 29>;
        };

        Right_parent {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <30 31>;
        };

        Left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <40 41>;
        };

        Right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <44 45>;
        };
    };

    behaviors {
        ss_hs_modmorph: ss_hs_modmorph {
            compatible = "zmk,behavior-mod-morph";
            label = "SS_HS_MODMORPH";
            bindings = <&kp M>, <&kp RIGHT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        kh_hs_tapdance: kh_hs_tapdance {
            compatible = "zmk,behavior-tap-dance";
            label = "KH_HS_TAPDANCE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;
        };

        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp BACKSPACE
&kp TAB           &kp Q         &kp W         &kp E         &kp R         &kp T                         &kp Y         &kp U         &kp I         &kp O         &kp P         &kp LEFT_BRACKET
&kp LEFT_SHIFT    &kp A         &kp S         &kp D         &kp F         &kp G                         &kp H         &kp J         &kp K         &kp L         &kp SEMI      &kp SQT
&kp LEFT_CONTROL  &kp Z         &kp X         &kp C         &kp V         &kp B         &none    &none  &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH      &kp RIGHT_SHIFT
                                              &kp LALT      &lt 1 ENTER   &kp SPACE     &none    &none  &kp SPACE     &lt 2 ENTER   &kp RGUI
            >;
        };

        Lower {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp F1            &kp F2   &kp F3           &kp F4         &kp F5            &kp F6                              &kp F7     &kp F8  &kp F9  &kp F10  &kp F11       &kp F12
&kp GRAVE         &kp F10  &kp L            &kp H          &kp LC(J)         &kp LC(NUMBER_6)                    &kp PLUS   &kp N7  &kp N8  &kp N9   &kp ASTERISK  &kp SLASH
&kp LEFT_SHIFT    &kp F11  &kp Y            &kp U          &kp I             &kp NUMBER_0                        &kp MINUS  &kp N4  &kp N5  &kp N6   &kp DOT       &kp PIPE
&kp LEFT_CONTROL  &kp INS  &kp PRINTSCREEN  &kp LESS_THAN  &kp GREATER_THAN  &kp DEL           &trans    &trans  &kp N0     &kp N1  &kp N2  &kp N3   &kp EQUAL     &kp RIGHT_SHIFT
                                            &kp LEFT_ALT   &trans            &kp RG(E)         &trans    &trans  &trans     &trans  &trans
            >;
        };

        Raise {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&bt BT_CLR         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &none        &none        &none             &none             &none              &kp DEL
&kp RIGHT_BRACKET  &kp ASTERISK  &kp SLASH     &kp PLUS      &kp MINUS     &kp DOT                         &kp PLUS     &kp PERCENT  &kp UP_ARROW      &kp UNDERSCORE    &kp ASTERISK       &kp BACKSLASH
&kp LEFT_SHIFT     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                    &kp MINUS    &kp LEFT     &kp DOWN          &kp RIGHT_ARROW   &kp DOUBLE_QUOTES  &kp EQUAL
&kp LEFT_CONTROL   &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &trans    &trans  &kp AT_SIGN  &kp HASH     &kp LS(NUMBER_4)  &kp LS(NUMBER_6)  &kp LS(NUMBER_7)   &kp RIGHT_SHIFT
                                               &kp LEFT_ALT  &trans        &trans        &trans    &trans  &trans       &trans       &trans
            >;
        };
    };
};
